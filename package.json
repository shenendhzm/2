{
  "name": "remotion-helloworld",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion 官方 Hello World 结构的最小可渲染项目（已适配 DSH 容器）",
  "scripts": {
    "studio": "NODE_OPTIONS=--require=./scripts/fix-network-interfaces.cjs remotion studio --port 3033 --no-open",
    "bundle": "NODE_OPTIONS=--require=./scripts/fix-network-interfaces.cjs remotion bundle src/index.ts",
    "web:bundle": "esbuild web/main.tsx --bundle --outfile=dist-web/bundle.js --format=esm --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --target=es2022 --log-level=warning && cp web/index.html dist-web/index.html",
    "web:serve": "node scripts/serve-web.cjs 3034",
    "render": "remotion render HelloWorld out/video.mp4",
    "still": "remotion still HelloWorld out/frame.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "4.0.409",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.409"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "esbuild": "^0.25.0",
    "typescript": "5.8.3"
  }
}
